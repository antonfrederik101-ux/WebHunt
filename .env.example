# Supabase project settings. The publishable/anon key is public; RLS protects private data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server-side only. Enable PageSpeed Insights API in Google Cloud.
PAGESPEED_API_KEY=

# Optional dedicated/self-hosted Overpass HTTPS interpreter endpoint.
# When set, public endpoints are not used. Allow its hostname in environment networking.
OVERPASS_API_URL=
# Persistent volume recommended in production. Public OSM cache only (never commit).
# WEBHUNT_CACHE_DIR=/var/lib/webhunt/osm

# Optional browser-visible MapTiler key, restricted to your actual preview/website origins.
# Without it, the local public-domain country overview remains available.
NEXT_PUBLIC_MAPTILER_KEY=

# Company catalog. Defaults to persistent local SQLite in Codespaces.
# Set to supabase only after applying supabase/business-catalog.sql and importing data.
WEBHUNT_CATALOG_BACKEND=sqlite
# WEBHUNT_CATALOG_PATH=/var/lib/webhunt/businesses.sqlite
