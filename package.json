{
  "name": "webhunt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "node --use-env-proxy node_modules/next/dist/bin/next build --webpack",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests playwright.config.ts",
    "check:config": "node scripts/check-config.mjs",
    "data:refresh": "node scripts/data-refresh.mjs",
    "prebuild": "npm run check:config",
    "data:setup": "python3 -m venv .data/import-venv && .data/import-venv/bin/pip install -r scripts/import-requirements.txt",
    "data:import": "node --use-env-proxy --import tsx scripts/import-places.ts",
    "verify:pilot": "node --use-env-proxy --import tsx scripts/validate-pilot.ts",
    "verify:admin": "node scripts/admin-access.mjs",
    "verify:diagnose": "node --use-env-proxy --import tsx scripts/diagnose-websites.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
